 <%- include('header') %>

  <link rel="/public/css/bootrstrap.min.css">
 <link rel="/public/css/style.css">

<h1><%= title %></h1>

<% if (error) { %>
  <p style="color: red;"><%= error %></p>
<% } %>

<form method="POST" action="/login">
  <label for="login">Логин:</label>
  <input type="text" name="login" id="login" placeholder="Ваш логин"><br><br>

  <label for="password">Пароль:</label>
  <input type="password" name="password" id="password" placeholder="Ваш пароль"><br><br>

  <button type="submit">Войти</button>
</form>

<p><a href="/register">Нет аккаунта? Зарегистрироваться</a></p>
